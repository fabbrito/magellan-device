# What names one installation. Copy to .env.local for a dev tree, or an EnvironmentFile under
# systemd.
#
# None of this belongs in config.toml: a token is a credential, and coordinates, serials and
# addresses are home-network details. The repository is meant to be published, and a disclosure is
# what no later commit undoes.

# This device, as the cloud knows it.
MAGELLAN_DEVICE_ID=device_1
# Issued by the cloud, stored hashed there. Never commit the real one.
MAGELLAN_TOKEN=replace-me

# Where the installation is, in decimal degrees; north and east positive. Only a sun window needs
# them, and they are the site's location — treat them as such.
MAGELLAN_LATITUDE=-23.55
MAGELLAN_LONGITUDE=-46.63
# The site's IANA time zone, spelled as the tz database does. The cloud cuts calendar days in it.
MAGELLAN_TZ=America/Sao_Paulo

# Per source, named for its id in config.toml uppercased, punctuation as _: MAGELLAN_SOURCE_<ID>_...
# The serial identifies one logger; discovery finds its address by broadcasting for it when a sweep
# needs it, and again after a dial fails. Decimal, or hex with an 0x prefix as the logger's web UI
# shows it. Ten digits, and near the top of what a u32 holds — the placeholder is that size on
# purpose. Required unless HOST is set.
MAGELLAN_SOURCE_INVERTER_SERIAL=3735928559
# Optional. Set it to skip discovery and dial a known address instead.
#MAGELLAN_SOURCE_INVERTER_HOST=192.0.2.10
