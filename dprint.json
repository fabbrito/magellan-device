{
  "markdown": {
    "lineWidth": 100,
    "textWrap": "always"
  },
  "json": {
    "lineWidth": 100
  },
  "toml": {
    "lineWidth": 100,
    "indentWidth": 4
  },
  "yaml": {
    "printWidth": 100
  },
  "includes": ["**/*.md", "**/*.json", "**/*.toml", "**/*.{yml,yaml}"],
  // Fixtures are captured bytes and the values decoded from them. Reflowing a capture makes
  // it a worse record of the wire; the tests that read them are what grade them.
  "excludes": ["target/**", "**/fixtures/**"],
  "plugins": [
    "npm:@dprint/markdown@0.28.2",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/toml@0.9.0",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
